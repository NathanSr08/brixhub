<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BrixHub &bull; Master Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        dark: '#0a0d14',
                        surface: '#121824',
                        card: '#182032',
                        accent: '#3b82f6'
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scroll::-webkit-scrollbar-track { background: #0a0d14; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #1f293d; border-radius: 3px; }
    </style>
</head>
<body class="bg-dark text-slate-200 min-h-screen flex flex-col font-sans">

    <!-- Header -->
    <header class="border-b border-slate-800 bg-surface/80 backdrop-blur sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-red-500/20">A</div>
                <span class="font-bold text-sm sm:text-lg text-white">BrixHub <span class="text-red-400 text-[10px] font-mono px-1.5 py-0.5 rounded bg-red-500/10 border border-red-500/20">MASTER CONTROL</span></span>
            </div>
            <div class="flex items-center gap-2 sm:gap-4 text-xs">
                <button onclick="refreshData()" class="text-slate-400 hover:text-white p-1.5 sm:px-3 sm:py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg transition">
                    <i class="fa-solid fa-arrows-rotate sm:mr-1"></i><span class="hidden sm:inline">Actualiser</span>
                </button>
                <a href="/" target="_blank" class="hidden sm:inline text-slate-400 hover:text-white transition">App publique</a>
                <button onclick="logout()" class="px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition text-[11px]">
                    <i class="fa-solid fa-arrow-right-from-bracket sm:mr-1"></i><span class="hidden sm:inline">Déconnexion</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 sm:px-6 py-6 sm:py-8 flex-1 w-full space-y-6">
        
        <!-- Navigation Onglets Principaux -->
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex gap-2 text-xs font-semibold">
                <button id="tabBtnKeys" onclick="switchMainTab('keys')" class="px-4 py-2 rounded-xl bg-blue-600 text-white transition flex items-center gap-2">
                    <i class="fa-solid fa-key"></i> <span>Clés API (<span id="countKeys">0</span>)</span>
                </button>
                <button id="tabBtnUsers" onclick="switchMainTab('users')" class="px-4 py-2 rounded-xl bg-surface hover:bg-slate-800 text-slate-400 hover:text-white transition flex items-center gap-2 border border-slate-800">
                    <i class="fa-solid fa-users"></i> <span>Comptes Utilisateurs (<span id="countUsers">0</span>)</span>
                </button>
            </div>
        </div>

        <!-- ================= ONGLET 1 : CLÉS API ================= -->
        <div id="tabContentKeys" class="space-y-6">
            <!-- Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-4">
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Total Clés</div>
                    <div id="statTotalKeys" class="text-xl sm:text-2xl font-extrabold text-white mt-0.5">-</div>
                </div>
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Clés Actives</div>
                    <div id="statActiveKeys" class="text-xl sm:text-2xl font-extrabold text-emerald-400 mt-0.5">-</div>
                </div>
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Req API Aujourd'hui</div>
                    <div id="statReqToday" class="text-xl sm:text-2xl font-extrabold text-cyan-400 mt-0.5">-</div>
                </div>
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Plans Pro / Illimités</div>
                    <div id="statProKeys" class="text-xl sm:text-2xl font-extrabold text-blue-400 mt-0.5">-</div>
                </div>
            </div>

            <!-- Barre d'action Clés -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <div class="relative w-full sm:w-80">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-500 text-xs"></i>
                    <input type="text" id="searchKeysInput" oninput="filterKeys()" placeholder="Rechercher clé, label, email..."
                           class="w-full pl-9 pr-4 py-2 bg-surface border border-slate-800 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-blue-500">
                </div>
                <button onclick="openCreateModal()" class="w-full sm:w-auto px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-semibold transition flex items-center justify-center gap-2 shadow-lg shadow-blue-600/20">
                    <i class="fa-solid fa-plus"></i> Générer une clé API
                </button>
            </div>

            <!-- Table des Clés -->
            <div class="bg-surface border border-slate-800 rounded-xl overflow-hidden shadow-xl">
                <div class="overflow-x-auto custom-scroll">
                    <table class="w-full text-left text-xs text-slate-300 min-w-[750px]">
                        <thead class="bg-dark/70 text-slate-400 uppercase font-mono border-b border-slate-800 text-[10px]">
                            <tr>
                                <th class="py-3 px-4">Statut</th>
                                <th class="py-3 px-4">Label & Client</th>
                                <th class="py-3 px-4">Création</th>
                                <th class="py-3 px-4">Aperçu</th>
                                <th class="py-3 px-4">Plan</th>
                                <th class="py-3 px-4">Consommation Aujourd'hui</th>
                                <th class="py-3 px-4 text-emerald-400">Restant</th>
                                <th class="py-3 px-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="keysTableBody" class="divide-y divide-slate-800/60 font-sans">
                            <tr><td colspan="8" class="py-8 text-center text-slate-500">Chargement...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= ONGLET 2 : COMPTES UTILISATEURS ================= -->
        <div id="tabContentUsers" class="hidden space-y-6">
            <!-- Stats Users -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-4">
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Total Comptes</div>
                    <div id="statTotalUsers" class="text-xl sm:text-2xl font-extrabold text-white mt-0.5">-</div>
                </div>
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Comptes Actifs</div>
                    <div id="statActiveUsers" class="text-xl sm:text-2xl font-extrabold text-emerald-400 mt-0.5">-</div>
                </div>
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Comptes Illimités (Clé liée)</div>
                    <div id="statUnlimitedUsers" class="text-xl sm:text-2xl font-extrabold text-blue-400 mt-0.5">-</div>
                </div>
                <div class="bg-surface border border-slate-800 rounded-xl p-3.5 sm:p-5">
                    <div class="text-slate-400 text-[10px] sm:text-xs font-medium">Comptes Bannis</div>
                    <div id="statBannedUsers" class="text-xl sm:text-2xl font-extrabold text-red-400 mt-0.5">-</div>
                </div>
            </div>

            <!-- Barre de filtre Users -->
            <div class="flex items-center justify-between gap-3">
                <div class="relative w-full sm:w-80">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-500 text-xs"></i>
                    <input type="text" id="searchUsersInput" oninput="filterUsers()" placeholder="Rechercher par email..."
                           class="w-full pl-9 pr-4 py-2 bg-surface border border-slate-800 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
                </div>
            </div>

            <!-- Table des Utilisateurs -->
            <div class="bg-surface border border-slate-800 rounded-xl overflow-hidden shadow-xl">
                <div class="overflow-x-auto custom-scroll">
                    <table class="w-full text-left text-xs text-slate-300 min-w-[750px]">
                        <thead class="bg-dark/70 text-slate-400 uppercase font-mono border-b border-slate-800 text-[10px]">
                            <tr>
                                <th class="py-3 px-4">Statut</th>
                                <th class="py-3 px-4">Email Officiel</th>
                                <th class="py-3 px-4">Date d'inscription</th>
                                <th class="py-3 px-4">Plan Actif</th>
                                <th class="py-3 px-4">Clé API Liée</th>
                                <th class="py-3 px-4">Usage Aujourd'hui</th>
                                <th class="py-3 px-4 text-right">Actions de Gestion</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody" class="divide-y divide-slate-800/60 font-sans">
                            <tr><td colspan="7" class="py-8 text-center text-slate-500">Chargement des utilisateurs...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- Modal Détails Clé API (Logs REST + Quotas) -->
    <div id="detailsModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-2 sm:p-4">
        <div class="bg-surface border border-slate-800 rounded-2xl w-full max-w-5xl p-4 sm:p-6 space-y-4 shadow-2xl flex flex-col max-h-[92vh]">
            <div class="flex items-start justify-between border-b border-slate-800 pb-3">
                <div>
                    <h3 id="detModalTitle" class="font-bold text-white text-base">Détails de la clé API</h3>
                    <p id="detModalSubtitle" class="text-xs text-slate-400 font-mono"></p>
                </div>
                <button onclick="closeDetailsModal()" class="text-slate-500 hover:text-white text-lg">✕</button>
            </div>

            <div class="overflow-y-auto overflow-x-auto custom-scroll flex-1 border border-slate-800 rounded-xl bg-dark/40">
                <table class="w-full text-left text-xs text-slate-300 min-w-[550px]">
                    <thead class="bg-dark text-slate-400 font-mono sticky top-0 border-b border-slate-800 text-[10px]">
                        <tr>
                            <th class="py-2 px-3">Date</th>
                            <th class="py-2 px-3">IP</th>
                            <th class="py-2 px-3">Requête / URL</th>
                            <th class="py-2 px-3">Code</th>
                            <th class="py-2 px-3 text-right">Latence</th>
                        </tr>
                    </thead>
                    <tbody id="detLogsTableBody" class="divide-y divide-slate-800/60 font-mono text-[10px]"></tbody>
                </table>
            </div>

            <div class="flex justify-end pt-2">
                <button onclick="closeDetailsModal()" class="px-4 py-1.5 bg-slate-800 text-slate-300 rounded-lg text-xs">Fermer</button>
            </div>
        </div>
    </div>

    <!-- Modal Logs de Recherche WEB d'un Utilisateur -->
    <div id="userLogsModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-2 sm:p-4">
        <div class="bg-surface border border-slate-800 rounded-2xl w-full max-w-4xl p-4 sm:p-6 space-y-4 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex items-start justify-between border-b border-slate-800 pb-3">
                <div>
                    <h3 class="font-bold text-white text-base flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-indigo-400"></i>
                        <span>Historique des recherches du site</span>
                    </h3>
                    <p id="userLogsSubtitle" class="text-xs text-slate-400 font-mono mt-0.5"></p>
                </div>
                <button onclick="closeUserLogsModal()" class="text-slate-500 hover:text-white text-lg">✕</button>
            </div>

            <div class="overflow-y-auto overflow-x-auto custom-scroll flex-1 border border-slate-800 rounded-xl bg-dark/40">
                <table class="w-full text-left text-xs text-slate-300 min-w-[500px]">
                    <thead class="bg-dark text-slate-400 font-mono sticky top-0 border-b border-slate-800 text-[10px]">
                        <tr>
                            <th class="py-2 px-3">Date</th>
                            <th class="py-2 px-3">IP</th>
                            <th class="py-2 px-3">Critères Saisis</th>
                            <th class="py-2 px-3 text-right">Résultats Trouvés</th>
                        </tr>
                    </thead>
                    <tbody id="userLogsTableBody" class="divide-y divide-slate-800/60 font-mono text-[11px]"></tbody>
                </table>
            </div>

            <div class="flex justify-end pt-2">
                <button onclick="closeUserLogsModal()" class="px-4 py-1.5 bg-slate-800 text-slate-300 rounded-lg text-xs">Fermer</button>
            </div>
        </div>
    </div>

    <!-- Modal Lier une Clé API à un Compte (Admin) -->
    <div id="linkKeyModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-3">
        <div class="bg-surface border border-slate-800 rounded-2xl w-full max-w-md p-5 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <h3 class="font-bold text-white text-sm">Associer une Clé API au Compte</h3>
                <button onclick="closeLinkKeyModal()" class="text-slate-500 hover:text-white">✕</button>
            </div>
            <p id="linkKeyUserEmail" class="text-xs text-slate-400 font-mono"></p>

            <form id="formAdminLinkKey" class="space-y-3 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">Sélectionner une Clé API existante</label>
                    <select id="selectApiKey" class="w-full px-3 py-2 bg-dark border border-slate-700 rounded-lg text-white font-mono"></select>
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">Forfait attribué au compte</label>
                    <select id="selectUserPlan" class="w-full px-3 py-2 bg-dark border border-slate-700 rounded-lg text-white font-mono">
                        <option value="pro">pro (Accès Illimité Web)</option>
                        <option value="starter">starter (Accès Illimité Web)</option>
                        <option value="enterprise">enterprise (Accès Illimité Web)</option>
                        <option value="free">free (5 req/j)</option>
                    </select>
                </div>
                <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-semibold transition mt-2">
                    Confirmer l'association
                </button>
            </form>
        </div>
    </div>

    <!-- Modal Reset Mot de Passe (Admin) -->
    <div id="resetPassModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-3">
        <div class="bg-surface border border-slate-800 rounded-2xl w-full max-w-md p-5 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <h3 class="font-bold text-white text-sm">Réinitialiser le mot de passe</h3>
                <button onclick="closeResetPassModal()" class="text-slate-500 hover:text-white">✕</button>
            </div>
            <p id="resetPassUserEmail" class="text-xs text-slate-400 font-mono"></p>
            <form id="formAdminResetPass" class="space-y-3 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">Nouveau mot de passe temporaire</label>
                    <input type="text" id="adminNewPass" required minlength="6" placeholder="Ex: TempPass992!"
                           class="w-full px-3 py-2 bg-dark border border-slate-700 rounded-lg text-white font-mono">
                </div>
                <button type="submit" class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-lg font-semibold transition mt-2">
                    Appliquer le mot de passe
                </button>
            </form>
        </div>
    </div>

    <!-- Modal Création Nouvelle Clé -->
    <div id="createModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-3">
        <div class="bg-surface border border-slate-800 rounded-2xl w-full max-w-md p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <h3 class="font-bold text-white text-sm">Générer une Clé API</h3>
                <button onclick="closeCreateModal()" class="text-slate-500 hover:text-white">✕</button>
            </div>
            <form id="createKeyForm" class="space-y-3 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">Label</label>
                    <input type="text" id="newLabel" required placeholder="Client Telegram" class="w-full px-3 py-2 bg-dark border border-slate-700 rounded-lg text-white">
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">Email</label>
                    <input type="email" id="newEmail" required placeholder="client@gmail.com" class="w-full px-3 py-2 bg-dark border border-slate-700 rounded-lg text-white">
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">Plan</label>
                    <select id="newPlan" class="w-full px-3 py-2 bg-dark border border-slate-700 rounded-lg text-white font-mono">
                        <option value="free">free (50 req/j)</option>
                        <option value="starter">starter (1 000 req/j)</option>
                        <option value="pro" selected>pro (50 000 req/j)</option>
                        <option value="enterprise">enterprise (Illimité)</option>
                    </select>
                </div>
                <button type="submit" id="createBtn" class="w-full py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg font-semibold transition mt-2">
                    Générer la Clé
                </button>
            </form>
        </div>
    </div>

    <!-- Modal Affichage Clé Générée -->
    <div id="showKeyModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-3">
        <div class="bg-surface border border-emerald-500/40 rounded-2xl w-full max-w-md p-5 space-y-3">
            <h3 class="font-bold text-white text-sm text-center">Clé API Générée</h3>
            <div class="bg-dark p-3 rounded-lg border border-slate-700 font-mono text-[11px] text-emerald-300 break-all select-all" id="generatedRawKey"></div>
            <button onclick="copyGeneratedKey()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg text-xs">
                <span id="copyBtnText">Copier la clé</span>
            </button>
            <button onclick="closeShowKeyModal()" class="w-full py-1.5 bg-slate-800 text-slate-400 rounded-lg text-xs">Fermer</button>
        </div>
    </div>

    <script>
        let allKeys = [];
        let allUsers = [];
        let currentTargetUserId = null;

        function switchMainTab(tab) {
            const btnKeys = document.getElementById('tabBtnKeys');
            const btnUsers = document.getElementById('tabBtnUsers');
            const secKeys = document.getElementById('tabContentKeys');
            const secUsers = document.getElementById('tabContentUsers');

            if (tab === 'keys') {
                btnKeys.className = "px-4 py-2 rounded-xl bg-blue-600 text-white transition flex items-center gap-2";
                btnUsers.className = "px-4 py-2 rounded-xl bg-surface hover:bg-slate-800 text-slate-400 hover:text-white transition flex items-center gap-2 border border-slate-800";
                secKeys.classList.remove('hidden');
                secUsers.classList.add('hidden');
            } else {
                btnUsers.className = "px-4 py-2 rounded-xl bg-indigo-600 text-white transition flex items-center gap-2";
                btnKeys.className = "px-4 py-2 rounded-xl bg-surface hover:bg-slate-800 text-slate-400 hover:text-white transition flex items-center gap-2 border border-slate-800";
                secUsers.classList.remove('hidden');
                secKeys.classList.add('hidden');
            }
        }

        function formatDate(val) {
            if (!val) return '-';
            try {
                const d = new Date(val);
                if (isNaN(d.getTime())) return String(val).split('.')[0];
                return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
            } catch (e) { return String(val); }
        }

        async function refreshData() {
            await fetchKeys(); await fetchUsers();
        }

        // --- GESTION DES CLÉS API ---
        async function fetchKeys() {
            try {
                const res = await fetch('/admin/api/keys');
                if (res.status === 401) { window.location.href = '/admin/login'; return; }
                allKeys = await res.json();
                document.getElementById('countKeys').innerText = allKeys.length;
                renderKeysTable(allKeys);
                updateKeysStats(allKeys);
            } catch (e) {}
        }

        function updateKeysStats(keys) {
            document.getElementById('statTotalKeys').innerText = keys.length;
            document.getElementById('statActiveKeys').innerText = keys.filter(k => k.is_active === 1).length;
            const totalReq = keys.reduce((acc, k) => acc + (k.used_today || 0), 0);
            document.getElementById('statReqToday').innerText = totalReq.toLocaleString();
            document.getElementById('statProKeys').innerText = keys.filter(k => ['pro', 'enterprise'].includes(k.plan)).length;
        }

        function renderKeysTable(keys) {
            const tbody = document.getElementById('keysTableBody');
            if (!keys.length) {
                tbody.innerHTML = '<tr><td colspan="8" class="py-6 text-center text-slate-500">Aucune clé.</td></tr>';
                return;
            }
            tbody.innerHTML = keys.map(k => {
                const used = k.used_today || 0;
                const max = k.quota_per_day || 0;
                const pct = max > 0 ? Math.min(100, Math.round((used / max) * 100)) : 0;
                const remaining = k.remaining_today !== undefined ? k.remaining_today : (max - used);

                let badgeColor = 'bg-blue-500';
                if (pct >= 85) badgeColor = 'bg-amber-500';
                if (pct >= 100) badgeColor = 'bg-red-500';

                return `
                <tr class="hover:bg-card/60 cursor-pointer transition" onclick="openKeyDetails('${k.key_id}', '${escapeHtml(k.label || k.preview)}')">
                    <td class="py-2.5 px-4">
                        ${k.is_active === 1 
                            ? '<span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-mono text-[9px] border border-emerald-500/20">ACTIF</span>'
                            : '<span class="px-2 py-0.5 rounded-full bg-red-500/10 text-red-400 font-mono text-[9px] border border-red-500/20">RÉVOQUÉ</span>'}
                    </td>
                    <td class="py-2.5 px-4">
                        <div class="font-semibold text-white">${escapeHtml(k.label || '-')}</div>
                        <div class="text-[10px] text-slate-500 font-mono">${escapeHtml(k.owner_email || '-')}</div>
                    </td>
                    <td class="py-2.5 px-4 text-slate-400 font-mono text-[10px]">${formatDate(k.created_at)}</td>
                    <td class="py-2.5 px-4 font-mono text-slate-300 text-[10px]">${k.preview || '-'}</td>
                    <td class="py-2.5 px-4" onclick="event.stopPropagation()">
                        <select onchange="changeKeyPlan('${k.key_id}', this.value)" class="bg-dark border border-slate-700 rounded px-2 py-1 text-xs font-mono text-blue-400">
                            <option value="free" ${k.plan === 'free' ? 'selected' : ''}>free</option>
                            <option value="starter" ${k.plan === 'starter' ? 'selected' : ''}>starter</option>
                            <option value="pro" ${k.plan === 'pro' ? 'selected' : ''}>pro</option>
                            <option value="enterprise" ${k.plan === 'enterprise' ? 'selected' : ''}>enterprise</option>
                        </select>
                    </td>
                    <td class="py-2.5 px-4">
                        <div class="w-24 bg-slate-800 rounded-full h-1.5 overflow-hidden">
                            <div class="${badgeColor} h-full" style="width: ${max === 0 ? 5 : pct}%"></div>
                        </div>
                        <span class="text-[10px] text-slate-400 font-mono">${used}/${max === 0 ? '∞' : max}</span>
                    </td>
                    <td class="py-2.5 px-4 font-mono font-bold text-xs ${remaining <= 0 && max > 0 ? 'text-red-400' : 'text-emerald-400'}">
                        ${max === 0 ? 'Illimité' : remaining.toLocaleString()}
                    </td>
                    <td class="py-2.5 px-4 text-right space-x-1" onclick="event.stopPropagation()">
                        <button onclick="resetKeyQuota('${k.key_id}')" class="px-2 py-0.5 bg-amber-500/10 text-amber-400 rounded text-[10px] border border-amber-500/20">Reset</button>
                        ${k.is_active === 1
                            ? `<button onclick="revokeKey('${k.key_id}')" class="px-2 py-0.5 bg-red-500/10 text-red-400 rounded text-[10px] border border-red-500/20">Ban</button>`
                            : `<button onclick="reactivateKey('${k.key_id}')" class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 rounded text-[10px] border border-emerald-500/20">On</button>`}
                    </td>
                </tr>`;
            }).join('');
        }

        // --- GESTION DES UTILISATEURS ---
        async function fetchUsers() {
            try {
                const res = await fetch('/admin/api/users');
                if (!res.ok) return;
                allUsers = await res.json();
                document.getElementById('countUsers').innerText = allUsers.length;
                renderUsersTable(allUsers);
                updateUsersStats(allUsers);
            } catch (e) {}
        }

        function updateUsersStats(users) {
            document.getElementById('statTotalUsers').innerText = users.length;
            document.getElementById('statActiveUsers').innerText = users.filter(u => u.is_active === 1).length;
            document.getElementById('statUnlimitedUsers').innerText = users.filter(u => u.is_unlimited).length;
            document.getElementById('statBannedUsers').innerText = users.filter(u => u.is_active === 0).length;
        }

        function renderUsersTable(users) {
            const tbody = document.getElementById('usersTableBody');
            if (!users.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="py-6 text-center text-slate-500">Aucun compte utilisateur créé.</td></tr>';
                return;
            }

            tbody.innerHTML = users.map(u => {
                const isBanned = u.is_active === 0;
                const isUnlimited = u.is_unlimited;

                return `
                <tr class="hover:bg-card/60 transition">
                    <td class="py-3 px-4">
                        ${!isBanned 
                            ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[9px] font-mono border border-emerald-500/20">ACTIF</span>'
                            : '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-500/10 text-red-400 text-[9px] font-mono border border-red-500/20">BANNI</span>'}
                    </td>
                    <td class="py-3 px-4">
                        <div class="font-semibold text-white select-all">${escapeHtml(u.email)}</div>
                        <div class="text-[10px] text-slate-500 font-mono">ID: ${u.user_id.substring(0, 8)}...</div>
                    </td>
                    <td class="py-3 px-4 font-mono text-[11px] text-slate-400">${formatDate(u.created_at)}</td>
                    <td class="py-3 px-4">
                        <select onchange="changeUserPlan('${u.user_id}', this.value)" class="bg-dark border border-slate-700 rounded px-2 py-1 text-xs font-mono text-indigo-400">
                            <option value="free" ${u.plan === 'free' ? 'selected' : ''}>free (5 req/j)</option>
                            <option value="starter" ${u.plan === 'starter' ? 'selected' : ''}>starter (Illimité)</option>
                            <option value="pro" ${u.plan === 'pro' ? 'selected' : ''}>pro (Illimité)</option>
                            <option value="enterprise" ${u.plan === 'enterprise' ? 'selected' : ''}>enterprise (Illimité)</option>
                        </select>
                    </td>
                    <td class="py-3 px-4 font-mono text-xs">
                        ${u.api_key_id 
                            ? `<span class="text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/20 select-all">${u.api_key_id.substring(0, 10)}...</span>` 
                            : `<button onclick="openLinkKeyModal('${u.user_id}', '${escapeHtml(u.email)}')" class="text-slate-400 hover:text-white underline text-[11px]">+ Associer clé</button>`}
                    </td>
                    <td class="py-3 px-4 font-mono text-xs">
                        ${isUnlimited 
                            ? '<span class="text-emerald-400 font-bold">Illimité</span>' 
                            : `<span class="${u.used_today >= 5 ? 'text-red-400 font-bold' : 'text-slate-300'}">${u.used_today} / 5</span>`}
                    </td>
                    <td class="py-3 px-4 text-right space-x-1.5 whitespace-nowrap">
                        <button onclick="viewUserLogs('${u.user_id}', '${escapeHtml(u.email)}')" title="Voir les recherches du site faites par ce compte"
                                class="px-2.5 py-1 bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-400 border border-indigo-500/20 rounded text-[11px] transition">
                            <i class="fa-solid fa-list-check mr-1"></i>Recherches
                        </button>
                        <button onclick="resetUserQuota('${u.user_id}')" title="Débloquer les 5 requêtes"
                                class="px-2 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded text-[11px] transition">
                            Reset Quota
                        </button>
                        <button onclick="openResetPassModal('${u.user_id}', '${escapeHtml(u.email)}')" title="Changer le mot de passe"
                                class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[11px] transition">
                            <i class="fa-solid fa-key"></i>
                        </button>
                        <button onclick="toggleUserBan('${u.user_id}')" title="${isBanned ? 'Débannir' : 'Bannir'}"
                                class="px-2 py-1 ${isBanned ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20'} rounded text-[11px] transition">
                            ${isBanned ? 'Débannir' : 'Bannir'}
                        </button>
                    </td>
                </tr>`;
            }).join('');
        }

        // --- ACTIONS UTILISATEUR ---
        async function toggleUserBan(userId) {
            if (!confirm('Changer le statut d\'accès de ce compte ?')) return;
            const res = await fetch(`/admin/api/users/${userId}/status`, { method: 'PATCH' });
            if (res.ok) fetchUsers();
        }

        async function resetUserQuota(userId) {
            const res = await fetch(`/admin/api/users/${userId}/reset-quota`, { method: 'POST' });
            if (res.ok) fetchUsers();
        }

        async function changeUserPlan(userId, plan) {
            const res = await fetch(`/admin/api/users/${userId}/plan`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ plan })
            });
            if (res.ok) fetchUsers();
        }

        function openResetPassModal(userId, email) {
            currentTargetUserId = userId;
            document.getElementById('resetPassUserEmail').innerText = email;
            document.getElementById('adminNewPass').value = '';
            document.getElementById('resetPassModal').classList.remove('hidden');
        }
        function closeResetPassModal() { document.getElementById('resetPassModal').classList.add('hidden'); }

        document.getElementById('formAdminResetPass').addEventListener('submit', async (e) => {
            e.preventDefault();
            const new_password = document.getElementById('adminNewPass').value;
            const res = await fetch(`/admin/api/users/${currentTargetUserId}/reset-password`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ new_password })
            });
            if (res.ok) {
                alert('Mot de passe mis à jour avec succès !');
                closeResetPassModal();
            } else alert('Erreur');
        });

        function openLinkKeyModal(userId, email) {
            currentTargetUserId = userId;
            document.getElementById('linkKeyUserEmail').innerText = `Compte : ${email}`;
            const sel = document.getElementById('selectApiKey');
            sel.innerHTML = allKeys.map(k => `<option value="${k.key_id}">${k.preview} - ${k.label || 'Sans nom'} (${k.plan})</option>`).join('');
            document.getElementById('linkKeyModal').classList.remove('hidden');
        }
        function closeLinkKeyModal() { document.getElementById('linkKeyModal').classList.add('hidden'); }

        document.getElementById('formAdminLinkKey').addEventListener('submit', async (e) => {
            e.preventDefault();
            const key_id = document.getElementById('selectApiKey').value;
            const plan = document.getElementById('selectUserPlan').value;
            const res = await fetch(`/admin/api/users/${currentTargetUserId}/link-key`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ key_id, plan })
            });
            if (res.ok) {
                closeLinkKeyModal();
                fetchUsers();
            } else alert('Erreur');
        });

        async function viewUserLogs(userId, email) {
            document.getElementById('userLogsSubtitle').innerText = `Compte : ${email}`;
            const tbody = document.getElementById('userLogsTableBody');
            tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-slate-500">Chargement des recherches...</td></tr>';
            document.getElementById('userLogsModal').classList.remove('hidden');

            try {
                const res = await fetch(`/admin/api/users/${userId}/search-logs`);
                const logs = await res.json();
                if (!logs.length) {
                    tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-slate-500">Aucune recherche effectuée par ce compte.</td></tr>';
                    return;
                }
                tbody.innerHTML = logs.map(l => `
                    <tr class="hover:bg-slate-800/40">
                        <td class="py-2.5 px-3 text-slate-400 whitespace-nowrap">${formatDate(l.ts)}</td>
                        <td class="py-2.5 px-3 text-emerald-400 select-all font-semibold">${l.client_ip || '-'}</td>
                        <td class="py-2.5 px-3 text-slate-200 select-all break-all">${escapeHtml(l.criteria)}</td>
                        <td class="py-2.5 px-3 text-right font-bold ${l.nb_results > 0 ? 'text-indigo-400' : 'text-slate-500'}">${l.nb_results}</td>
                    </tr>
                `).join('');
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-red-400">Erreur lors de la récupération des logs.</td></tr>';
            }
        }
        function closeUserLogsModal() { document.getElementById('userLogsModal').classList.add('hidden'); }

        // --- FILTRES ---
        function filterKeys() {
            const q = document.getElementById('searchKeysInput').value.toLowerCase();
            renderKeysTable(allKeys.filter(k => 
                (k.label || '').toLowerCase().includes(q) ||
                (k.owner_email || '').toLowerCase().includes(q) ||
                (k.preview || '').toLowerCase().includes(q)
            ));
        }

        function filterUsers() {
            const q = document.getElementById('searchUsersInput').value.toLowerCase();
            renderUsersTable(allUsers.filter(u => (u.email || '').toLowerCase().includes(q)));
        }

        // Fonctions Clés Modal
        async function openKeyDetails(keyId, label) {
            document.getElementById('detModalTitle').innerText = label;
            document.getElementById('detModalSubtitle').innerText = `ID: ${keyId}`;
            const tbody = document.getElementById('detLogsTableBody');
            tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-slate-500">Chargement...</td></tr>';
            document.getElementById('detailsModal').classList.remove('hidden');

            const res = await fetch(`/admin/api/keys/${keyId}/logs`);
            const logs = await res.json();
            tbody.innerHTML = logs.map(l => `
                <tr class="hover:bg-slate-800/40">
                    <td class="py-2 px-3 text-slate-400">${formatDate(l.ts)}</td>
                    <td class="py-2 px-3 text-emerald-400 font-semibold">${l.client_ip || '-'}</td>
                    <td class="py-2 px-3 text-slate-200 break-all select-all">${escapeHtml(l.endpoint)}</td>
                    <td class="py-2 px-3"><span class="px-1 py-0.5 rounded text-[9px] ${l.status >= 400 ? 'bg-red-500/20 text-red-400' : 'bg-emerald-500/20 text-emerald-400'}">${l.status}</span></td>
                    <td class="py-2 px-3 text-right text-slate-400">${l.latency_ms}ms</td>
                </tr>
            `).join('');
        }
        function closeDetailsModal() { document.getElementById('detailsModal').classList.add('hidden'); }
        async function resetKeyQuota(keyId) {
            if (!confirm('Remettre à zéro le quota de cette clé ?')) return;
            const res = await fetch(`/admin/api/keys/${keyId}/reset-quota`, { method: 'POST' });
            if (res.ok) fetchKeys();
        }
        async function changeKeyPlan(keyId, newPlan) {
            const res = await fetch(`/admin/api/keys/${keyId}/plan`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ plan: newPlan })
            });
            if (res.ok) fetchKeys();
        }
        async function revokeKey(keyId) {
            if (!confirm('Révoquer la clé ?')) return;
            const res = await fetch(`/admin/api/keys/${keyId}`, { method: 'DELETE' });
            if (res.ok) fetchKeys();
        }
        async function reactivateKey(keyId) {
            const res = await fetch(`/admin/api/keys/${keyId}/reactivate`, { method: 'POST' });
            if (res.ok) fetchKeys();
        }

        function openCreateModal() { document.getElementById('createModal').classList.remove('hidden'); }
        function closeCreateModal() { document.getElementById('createModal').classList.add('hidden'); }
        function closeShowKeyModal() { document.getElementById('showKeyModal').classList.add('hidden'); }

        document.getElementById('createKeyForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const label = document.getElementById('newLabel').value.trim();
            const owner_email = document.getElementById('newEmail').value.trim();
            const plan = document.getElementById('newPlan').value;
            const res = await fetch('/admin/api/keys', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ label, owner_email, plan })
            });
            const data = await res.json();
            if (res.ok) {
                closeCreateModal();
                document.getElementById('generatedRawKey').innerText = data.key;
                document.getElementById('showKeyModal').classList.remove('hidden');
                fetchKeys();
            } else alert(data.detail || 'Erreur');
        });

        function copyGeneratedKey() {
            navigator.clipboard.writeText(document.getElementById('generatedRawKey').innerText);
            document.getElementById('copyBtnText').innerText = 'Copié !';
            setTimeout(() => document.getElementById('copyBtnText').innerText = 'Copier la clé', 2000);
        }

        async function logout() {
            await fetch('/admin/api/logout', { method: 'POST' });
            window.location.href = '/admin/login';
        }

        function escapeHtml(str) { return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

        (async () => { await fetchKeys(); await fetchUsers(); })();
    </script>
<script src="/static/logs.js"></script>
<script src="/static/logs-extra.js"></script>
</body>
</html>
